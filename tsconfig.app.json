{
  "include": ["src/**/*", "types", "components.d.ts"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["es2020", "DOM"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@views/*": ["./src/views/*"],
      "@assets/*": ["./src/assets/*"],
      "@img/*": ["./src/assets/image/*"],
      "@audio/*": ["./src/assets/audio/*"]
    },
    "types": ["vite/client"],
    "target": "es5", // 不用 esnext，确保旧环境兼容
    "useDefineForClassFields": false, // 让类字段变成 constructor 赋值
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,

  }
}