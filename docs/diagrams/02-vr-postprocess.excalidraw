    {
      "id": "sdf_formula",
      "type": "text",
      "x": 55,
      "y": 235,
      "width": 500,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 201040,
      "version": 1,
      "versionNonce": 201040,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "pow(|dx|ⁿ + |dy|ⁿ, 1/n) < 1 → 遮罩内（显示场景）\n                           > 1 → 遮罩外（填充白色）",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "pow(|dx|ⁿ + |dy|ⁿ, 1/n) < 1 → 遮罩内（显示场景）\n                           > 1 → 遮罩外（填充白色）"
    },
